"""Deskpal 使用的 1.11.3 公共接口。只用于静态检查，不替换运行时组件库。"""
from enum import Enum
from typing import Any, Callable
from PySide6.QtCore import QPoint, SignalInstance
from PySide6.QtGui import QColor, QIcon
from PySide6.QtWidgets import (
    QCheckBox, QDoubleSpinBox, QFrame, QHBoxLayout, QLabel, QLineEdit,
    QListWidget, QMenu, QPlainTextEdit, QPushButton, QScrollArea, QSlider,
    QSpinBox, QStackedWidget, QToolButton, QTreeWidget, QWidget,
)

class BodyLabel(QLabel): ...
class CheckBox(QCheckBox): ...
class DoubleSpinBox(QDoubleSpinBox): ...
class LineEdit(QLineEdit):
    def __init__(self, parent: QWidget | None = ...) -> None: ...
class ListWidget(QListWidget): ...
class PlainTextEdit(QPlainTextEdit): ...
class PushButton(QPushButton): ...
class TransparentPushButton(QPushButton):
    def setIcon(self, icon: Any) -> None: ...
class ScrollArea(QScrollArea): ...
class Slider(QSlider): ...
class SpinBox(QSpinBox): ...
class ToolButton(QToolButton): ...
class TreeWidget(QTreeWidget): ...

class ComboBox(QPushButton):
    currentIndexChanged: SignalInstance
    currentTextChanged: SignalInstance
    activated: SignalInstance
    textActivated: SignalInstance
    dropMenu: RoundMenu | None
    def __init__(self, parent: QWidget | None = ...) -> None: ...
    def addItem(self, text: str, icon: Any = ..., userData: Any = ...) -> None: ...
    def clear(self) -> None: ...
    def count(self) -> int: ...
    def findData(self, data: Any) -> int: ...
    def findText(self, text: str) -> int: ...
    def currentIndex(self) -> int: ...
    def currentText(self) -> str: ...
    def currentData(self) -> Any: ...
    def setCurrentIndex(self, index: int) -> None: ...
    def setCurrentText(self, text: str) -> None: ...
    def setPlaceholderText(self, text: str) -> None: ...
    def itemData(self, index: int) -> Any: ...
    def itemText(self, index: int) -> str: ...
    def setItemData(self, index: int, value: Any) -> None: ...
    def setItemText(self, index: int, text: str) -> None: ...

class Pivot(QWidget):
    def __init__(self, parent: QWidget | None = ...) -> None: ...
    def addItem(self, routeKey: str, text: str, onClick: Callable[[], None] | None = ...) -> Any: ...
    def setCurrentItem(self, routeKey: str) -> None: ...
    def setItemText(self, routeKey: str, text: str) -> None: ...

class RoundMenu(QMenu):
    def __init__(self, title: str = ..., parent: QWidget | None = ...) -> None: ...
    # 库确实重新定义了 QMenu.exec 的参数与非阻塞返回，按真实公共 API 描述。
    def exec(self, pos: QPoint = ..., ani: bool = ..., aniType: Any = ...) -> Any: ...  # type: ignore[override]

class NavigationItemPosition(Enum):
    TOP = 0
    BOTTOM = 1
    SCROLL = 2

class FluentIcon(Enum):
    CHAT = ...
    CALENDAR = ...
    BOOK_SHELF = ...
    APPLICATION = ...
    SETTING = ...
    CHEVRON_DOWN_MED = ...

class NavigationInterface(QWidget):
    def expand(self, useAni: bool = ...) -> None: ...
    def setExpandWidth(self, width: int) -> None: ...
    def setMinimumExpandWidth(self, width: int) -> None: ...
    def setReturnButtonVisible(self, visible: bool) -> None: ...
    def setCurrentItem(self, routeKey: str) -> None: ...

class StackedWidget(QFrame):
    currentChanged: SignalInstance
    def setAnimationEnabled(self, enabled: bool) -> None: ...
    def currentIndex(self) -> int: ...
    def currentWidget(self) -> QWidget: ...
    def setCurrentIndex(self, index: int, popOut: bool = ...) -> None: ...
    def widget(self, index: int) -> QWidget | None: ...
    def count(self) -> int: ...

class FluentWindow(QWidget):
    navigationInterface: NavigationInterface
    stackedWidget: StackedWidget
    widgetLayout: QHBoxLayout
    def __init__(self, parent: QWidget | None = ...) -> None: ...
    def setMicaEffectEnabled(self, enabled: bool) -> None: ...
    def addSubInterface(self, interface: QWidget, icon: Any, text: str,
                        position: NavigationItemPosition = ...) -> QWidget: ...

class Theme(Enum):
    AUTO = ...
    LIGHT = ...
    DARK = ...

class QConfig:
    themeChanged: SignalInstance
qconfig: QConfig

def isDarkTheme() -> bool: ...
def setTheme(theme: Theme, save: bool = ..., lazy: bool = ...) -> None: ...
def setThemeColor(color: QColor | str, save: bool = ..., lazy: bool = ...) -> None: ...
def setCustomStyleSheet(widget: QWidget, lightQss: str, darkQss: str) -> None: ...
